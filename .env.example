# Konfigurasi Supabase untuk mode sinkronisasi cloud dan pemantauan Guru
# Dapatkan kredensial ini dari dashboard project Supabase:
# Masuk ke menu Project Settings -> API
# Salin Project URL dan Project API Keys (bagian 'anon' / 'public')
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
